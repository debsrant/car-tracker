{
  "folders": [
    {
      "name": "Car Tracker",
      "path": "."
    },
    {
      "name": "Dev Hub (Docs & Runbooks)",
      "path": "../dev-hub"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "files.autoSave": "off",
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/package-lock.json": true
    },
    "terminal.integrated.cwd": "${workspaceFolder:Car Tracker}"
  }
}